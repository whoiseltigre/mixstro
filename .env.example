# Supabase project (Project settings → API). Leave empty to run in demo mode.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Set to "on" once Sign in with Apple is configured in Supabase.
NEXT_PUBLIC_APPLE_SIGN_IN=

# Sample musicians (Eli, Maya, Jonah...) fill out Today, Search and Messages for
# signed-in people too, for testing. Set to "off" at launch so only real people show.
NEXT_PUBLIC_SAMPLE_PEOPLE=

# Artist search (/api/artists). Leave empty to use Deezer, which needs no key.
# Fill all three to switch to Apple Music: Team ID, MusicKit Key ID, and the
# full text of the .p8 key file (server-only, never NEXT_PUBLIC_).
APPLE_TEAM_ID=
APPLE_MUSIC_KEY_ID=
APPLE_MUSIC_PRIVATE_KEY=
# Optional two-letter Apple Music storefront, default "us".
APPLE_MUSIC_STOREFRONT=

# Email notifications (server only, never NEXT_PUBLIC). Without them, no emails are sent.
# On Amplify these must also reach the server at runtime: add to the build spec, before `npm run build`:
#   - env | grep -e RESEND_API_KEY -e SUPABASE_SERVICE_ROLE_KEY >> .env.production
RESEND_API_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# APP_URL=https://app.mixstro.com
